# Copy to .env.local (git-ignored) for local development, and set the same
# variable in your hosting provider's build environment for production.
#
# Web3Forms access key for the /sales-role/ application form. Create one at
# https://web3forms.com (enter the inbox that should receive applications).
# Access keys are public by design; they only let a form post to that inbox.
VITE_WEB3FORMS_ACCESS_KEY=
